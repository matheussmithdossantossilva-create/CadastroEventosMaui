<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventosMaui.Views.ResumoEventoPage"
             Title="Resumo do Evento"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label Text="Evento cadastrado!"
                   FontSize="27"
                   FontAttributes="Bold"
                   TextColor="#15803D"
                   HorizontalOptions="Center"/>

            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeShape="RoundRectangle 15"
                    Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label Text="RESUMO DO EVENTO"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E3A8A"/>

                    <Label Text="{Binding Nome, StringFormat='Nome do evento: {0}'}"
                           TextColor="#111827"/>

                    <Label Text="{Binding DataInicio, StringFormat='Data de início: {0:dd/MM/yyyy}'}"
                           TextColor="#111827"/>

                    <Label Text="{Binding DataTermino, StringFormat='Data de término: {0:dd/MM/yyyy}'}"
                           TextColor="#111827"/>

                    <Label Text="{Binding DuracaoEmDias, StringFormat='Duração: {0} dias'}"
                           TextColor="#111827"/>

                    <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}"
                           TextColor="#111827"/>

                    <Label Text="{Binding Local, StringFormat='Local: {0}'}"
                           TextColor="#111827"/>

                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C}'}"
                           TextColor="#111827"/>

                    <BoxView HeightRequest="1"
                             Color="#CBD5E1"/>

                    <Label Text="{Binding CustoTotal, StringFormat='CUSTO TOTAL: {0:C}'}"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#15803D"/>

                </VerticalStackLayout>

            </Border>

            <Button Text="VOLTAR AO CADASTRO"
                    Clicked="Voltar_Clicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
